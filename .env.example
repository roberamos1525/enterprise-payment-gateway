# Copy to .env and fill in. NEVER commit real secrets.
# SIMULATION ONLY: this gateway must only ever see synthetic test card data.

GATEWAY_ENV=prod
GATEWAY_LISTEN_ADDR=127.0.0.1:8080
GATEWAY_DB_PATH=gateway.db
GATEWAY_LOG_LEVEL=info
GATEWAY_LOG_FORMAT=json

# Vault data-encryption keys: id:base64(32 random bytes), primary first.
# Generate with: go run ./cmd/gatewayctl gen-key -id k1
# To rotate: prepend a new key (k2:...,k1:...), restart, then POST /admin/v1/vault/rewrap.
GATEWAY_VAULT_KEYS=k1:REPLACE_WITH_BASE64_32_BYTE_KEY
# HMAC secret for card fingerprints (>= 16 chars). Keep stable across key rotations.
GATEWAY_FINGERPRINT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING
# Operator bearer tokens: name:token[,name:token] (tokens >= 24 chars).
GATEWAY_ADMIN_TOKENS=ops:REPLACE_WITH_LONG_RANDOM_TOKEN

# Optional overrides (defaults shown)
# GATEWAY_TRUST_PROXY_HEADERS=false
# GATEWAY_MAX_BODY_BYTES=1048576
# GATEWAY_RATE_MERCHANT_RPS=25
# GATEWAY_RATE_MERCHANT_BURST=50
# GATEWAY_AUTH_TTL=168h
# GATEWAY_ACQUIRER_LATENCY=20ms
# GATEWAY_ACQUIRER_DISCREPANCY_RATE=0
# GATEWAY_FRAUD_BLOCKED_BINS=410000
# GATEWAY_FEE_PERCENT_BPS=290
# GATEWAY_FEE_FIXED_MINOR=30
# GATEWAY_PAYOUT_DELAY_DAYS=2
# GATEWAY_SETTLEMENT_AUTO_RUN=false
# GATEWAY_WEBHOOK_ALLOW_HTTP=false
# GATEWAY_WEBHOOK_ALLOW_PRIVATE=false
# GATEWAY_WEBHOOK_MAX_ATTEMPTS=8

# gatewayctl
# GATEWAY_URL=http://127.0.0.1:8080
# GATEWAY_ADMIN_TOKEN=REPLACE_WITH_ONE_OF_THE_ADMIN_TOKENS
